    <!-- Services Section -->
    <section id="servicios" class="services">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Nuestros Servicios</h2>
                <p class="section-description">Especializados en reparación y mantenimiento de electrodomésticos</p>
            </div>

            <div class="services__grid">
                <!-- Service 1: Refrigerators -->
                <article class="service-card">
                    <div class="service-card__icon">
                        <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
                            <rect x="15" y="5" width="30" height="50" rx="3" stroke="currentColor" stroke-width="2.5" />
                            <line x1="15" y1="28" x2="45" y2="28" stroke="currentColor" stroke-width="2.5" />
                            <circle cx="20" cy="16" r="1.5" fill="currentColor" />
                            <circle cx="20" cy="40" r="1.5" fill="currentColor" />
                            <rect x="18" y="10" width="8" height="12" rx="1" fill="currentColor" opacity="0.2" />
                        </svg>
                    </div>
                    <h3 class="service-card__title">Reparación de Neveras</h3>
                    <p class="service-card__description">
                        Diagnóstico y reparación de todo tipo de neveras y refrigeradores.
                        Problemas de enfriamiento, fugas, ruidos y más.
                    </p>
                    <ul class="service-card__features">
                        <li>✓ Todas las marcas</li>
                        <li>✓ Repuestos originales</li>
                        <li>✓ Garantía incluida</li>
                    </ul>
                </article>

                <!-- Service 2: Washing Machines -->
                <article class="service-card service-card--featured">
                    <div class="service-card__badge">Popular</div>
                    <div class="service-card__icon">
                        <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
                            <rect x="12" y="8" width="36" height="44" rx="3" stroke="currentColor" stroke-width="2.5" />
                            <circle cx="30" cy="35" r="11" stroke="currentColor" stroke-width="2.5" />
                            <circle cx="30" cy="35" r="6" stroke="currentColor" stroke-width="2" />
                            <circle cx="20" cy="16" r="2" fill="currentColor" />
                            <circle cx="28" cy="16" r="2" fill="currentColor" />
                            <circle cx="36" cy="16" r="2" fill="currentColor" />
                        </svg>
                    </div>
                    <h3 class="service-card__title">Reparación de Lavadoras</h3>
                    <p class="service-card__description">
                        Expertos en lavadoras automáticas y semi-automáticas.
                        Solución a problemas de centrifugado, desagüe y más.
                    </p>
                    <ul class="service-card__features">
                        <li>✓ Servicio a domicilio</li>
                        <li>✓ Diagnóstico gratis*</li>
                        <li>✓ Respuesta rápida</li>
                    </ul>
                </article>

                <!-- Service 3: Maintenance -->
                <article class="service-card">
                    <div class="service-card__icon">
                        <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
                            <path d="M25 15L22 25H18L15 35L20 45H25L28 35L33 45H38L43 35L40 25H36L33 15L28 25L25 15Z"
                                stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
                            <circle cx="30" cy="30" r="4" fill="currentColor" opacity="0.3" />
                        </svg>
                    </div>
                    <h3 class="service-card__title">Mantenimiento Preventivo</h3>
                    <p class="service-card__description">
                        Mantenimiento regular para prolongar la vida útil de tus electrodomésticos.
                        Evita reparaciones costosas.
                    </p>
                    <ul class="service-card__features">
                        <li>✓ Limpieza profunda</li>
                        <li>✓ Revisión completa</li>
                        <li>✓ Recomendaciones</li>
                    </ul>
                </article>
            </div>

            <!-- Pricing Info -->
            <div class="pricing-banner">
                <div class="pricing-banner__content">
                    <h3 class="pricing-banner__title">🎯 Revisión: $40,000 COP</h3>
                    <p class="pricing-banner__text">
                        <strong>¡Gratis si acepta la reparación!</strong>
                        Visitamos su hogar, diagnosticamos el problema y le damos un presupuesto sin compromiso.
                    </p>
                </div>
            </div>
        </div>
    </section>

